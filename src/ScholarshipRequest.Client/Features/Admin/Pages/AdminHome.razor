@page "/admin"
@layout AdminLayout
@attribute [Authorize(Policy = AuthenticationConstants.StaffPolicy)]

<PageTitle>แดชบอร์ดคำขอทุน</PageTitle>

<section class="dashboard" aria-labelledby="dashboard-title" aria-busy="@_loading">
    <header>
        <MudText Typo="Typo.overline" Color="Color.Primary">STAFF DASHBOARD</MudText>
        <MudText Typo="Typo.h3" id="dashboard-title">ภาพรวมคำขอทุนการศึกษา</MudText>
        <MudText Typo="Typo.body2" Class="muted-text">ข้อมูลรวมของคำขอที่ยังไม่ถูกลบในระบบ</MudText>
    </header>

    @if (_loading)
    {
        <MudPaper Outlined="true" Class="state-card" role="status">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>กำลังโหลดแดชบอร์ด...</MudText>
        </MudPaper>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="state-card">
            <MudText Typo="Typo.h6">@_error.Title</MudText>
            <MudText Typo="Typo.body2">@(_error.Detail ?? "กรุณาลองอีกครั้ง")</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="LoadAsync" Class="mt-3"
                       StartIcon="@Icons.Material.Filled.Refresh">ลองอีกครั้ง</MudButton>
        </MudAlert>
    }
    else if (_summary is not null)
    {
        <MudGrid Spacing="3" Class="summary-grid">
            <MudItem xs="12" sm="6" lg="3">
                <MudCard Outlined="true" Class="summary-card total-card">
                    <MudCardContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle2">คำขอทั้งหมด</MudText>
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" />
                        </MudStack>
                        <MudText Typo="Typo.h3">@_summary.TotalRequests.ToString("N0")</MudText>
                        <MudText Typo="Typo.caption">รวม @FormatMoney(_summary.TotalRequestedAmount)</MudText>
                    </MudCardContent>
                    <MudCardActions><MudButton Href="/admin/requests" Color="Color.Primary">ดูรายการ</MudButton></MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <MudCard Outlined="true" Class="summary-card pending-card">
                    <MudCardContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle2">รอพิจารณา</MudText>
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Warning" />
                        </MudStack>
                        <MudText Typo="Typo.h3">@_summary.PendingRequests.ToString("N0")</MudText>
                        <MudText Typo="Typo.caption">Pending</MudText>
                    </MudCardContent>
                    <MudCardActions><MudButton Href="/admin/requests?status=Pending" Color="Color.Warning">ดูรายการ</MudButton></MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <MudCard Outlined="true" Class="summary-card approved-card">
                    <MudCardContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle2">อนุมัติ</MudText>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                        </MudStack>
                        <MudText Typo="Typo.h3">@_summary.ApprovedRequests.ToString("N0")</MudText>
                        <MudText Typo="Typo.caption">Approved</MudText>
                    </MudCardContent>
                    <MudCardActions><MudButton Href="/admin/requests?status=Approved" Color="Color.Success">ดูรายการ</MudButton></MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <MudCard Outlined="true" Class="summary-card rejected-card">
                    <MudCardContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle2">ปฏิเสธ</MudText>
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" />
                        </MudStack>
                        <MudText Typo="Typo.h3">@_summary.RejectedRequests.ToString("N0")</MudText>
                        <MudText Typo="Typo.caption">Rejected</MudText>
                    </MudCardContent>
                    <MudCardActions><MudButton Href="/admin/requests?status=Rejected" Color="Color.Error">ดูรายการ</MudButton></MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3" Class="dashboard-grid">
            <MudItem xs="12" lg="5">
                <MudPaper Outlined="true" Class="dashboard-panel">
                    <MudText Typo="Typo.h6" id="status-chart-title">สัดส่วนตามสถานะ</MudText>
                    <MudText Typo="Typo.body2" Class="muted-text">จำนวนคำขอในแต่ละสถานะ</MudText>
                    <div class="bar-chart" role="img" aria-label="กราฟจำนวนคำขอแยกตามสถานะ">
                        @foreach (var item in StatusChartItems)
                        {
                            <div class="bar-row">
                                <span>@item.Label</span>
                                <div class="bar-track" aria-hidden="true">
                                    <div class="bar-fill @item.CssClass" style="width: @BarWidth(item.Value)%"></div>
                                </div>
                                <strong>@item.Value.ToString("N0")</strong>
                            </div>
                        }
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="7">
                <MudPaper Outlined="true" Class="dashboard-panel type-summary">
                    <MudText Typo="Typo.h6" id="type-summary-title">สรุปตามประเภททุน</MudText>
                    <MudText Typo="Typo.body2" Class="muted-text">จำนวนคำขอและยอดเงินที่ขอรวมทุกสถานะ</MudText>
                    @if (_summary.ByScholarshipType.Count == 0)
                    {
                        <MudText Class="empty-text">ยังไม่มีข้อมูลประเภททุน</MudText>
                    }
                    else
                    {
                        <MudTable Items="_summary.ByScholarshipType" Dense="true" Hover="true" Class="type-table">
                            <HeaderContent>
                                <MudTh>ประเภททุน</MudTh>
                                <MudTh>จำนวนคำขอ</MudTh>
                                <MudTh>ยอดเงินรวม</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="item">
                                <MudTd DataLabel="ประเภททุน"><MudLink Href="@TypeFilterUrl(item.ScholarshipTypeId)">@item.ScholarshipTypeName</MudLink></MudTd>
                                <MudTd DataLabel="จำนวนคำขอ">@item.RequestCount.ToString("N0")</MudTd>
                                <MudTd DataLabel="ยอดเงินรวม">@FormatMoney(item.TotalRequestedAmount)</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</section>
