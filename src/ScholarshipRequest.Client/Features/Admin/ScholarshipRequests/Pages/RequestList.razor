@page "/admin/requests"
@layout AdminLayout
@attribute [Authorize(Policy = AuthenticationConstants.StaffPolicy)]
@implements IAsyncDisposable

<PageTitle>รายการคำขอทุนการศึกษา</PageTitle>

<section class="request-list-page" aria-labelledby="request-list-title" aria-busy="@_loading">
    <header class="page-header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">SCHOLARSHIP REQUESTS</MudText>
            <MudText Typo="Typo.h3" id="request-list-title">รายการคำขอทุนการศึกษา</MudText>
            <MudText Typo="Typo.body2" Class="muted-text">ค้นหาและตรวจสอบคำขอ โดยระบบแสดงหน้าละ 10 รายการ</MudText>
        </div>
        <MudButton Href="/admin/requests/new"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add">
            เพิ่มคำขอแทนนักศึกษา
        </MudButton>
    </header>

    <MudPaper Outlined="true" Class="filters-panel">
        <form class="filters" @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault>
            <MudTextField T="string"
                          Label="ค้นหารหัส ชื่อนักศึกษา หรือเลขที่คำขอ"
                          Placeholder="เช่น 6600000001 หรือนักศึกษาจำลอง"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          @bind-Value="_searchInput"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="search-field" />

            <MudSelect T="string"
                       Label="สถานะ"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       @bind-Value="_statusInput">
                <MudSelectItem Value="@string.Empty">ทุกสถานะ</MudSelectItem>
                <MudSelectItem Value="@("Pending")">รอพิจารณา</MudSelectItem>
                <MudSelectItem Value="@("Approved")">อนุมัติ</MudSelectItem>
                <MudSelectItem Value="@("Rejected")">ปฏิเสธ</MudSelectItem>
            </MudSelect>

            <MudSelect T="string"
                       Label="ประเภททุน"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="@(_scholarshipTypes.Count == 0)"
                       @bind-Value="_typeInput">
                <MudSelectItem Value="@string.Empty">ทุกประเภททุน</MudSelectItem>
                @foreach (var type in _scholarshipTypes)
                {
                    <MudSelectItem Value="@type.Id.ToString()">
                        @type.Name@(!type.IsActive ? " (ปิดใช้งาน)" : string.Empty)
                    </MudSelectItem>
                }
            </MudSelect>

            <MudStack Row="true" Spacing="1" Class="filter-actions">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="_loading"
                           StartIcon="@Icons.Material.Filled.FilterAlt">
                    ค้นหา
                </MudButton>
                <MudButton ButtonType="ButtonType.Button"
                           Variant="Variant.Text"
                           Color="Color.Default"
                           Disabled="_loading"
                           OnClick="ClearFiltersAsync"
                           StartIcon="@Icons.Material.Filled.FilterAltOff">
                    ล้างตัวกรอง
                </MudButton>
            </MudStack>
        </form>
    </MudPaper>

    @if (_loading && _result is null)
    {
        <MudPaper Outlined="true" Class="state-card" role="status">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>กำลังโหลดรายการคำขอ...</MudText>
        </MudPaper>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="state-card">
            <MudText Typo="Typo.h6">@_error.Title</MudText>
            <MudText Typo="Typo.body2">@(_error.Detail ?? "กรุณาลองอีกครั้ง")</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RetryAsync" Class="mt-3"
                       StartIcon="@Icons.Material.Filled.Refresh">ลองอีกครั้ง</MudButton>
        </MudAlert>
    }
    else if (_result is not null)
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="result-summary">
            <MudText Typo="Typo.body2">พบ <strong>@_result.TotalItems.ToString("N0")</strong> รายการ</MudText>
            @if (_loading)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
            }
        </MudStack>

        @if (_result.Items.Count == 0)
        {
            <MudPaper Outlined="true" Class="state-card empty-state">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6">@(HasFilters ? "ไม่พบรายการที่ตรงกับเงื่อนไข" : "ยังไม่มีคำขอทุน")</MudText>
                <MudText Typo="Typo.body2">@(HasFilters ? "ลองเปลี่ยนคำค้นหาหรือล้างตัวกรอง" : "คำขอที่ส่งเข้าระบบจะแสดงที่นี่")</MudText>
                @if (HasFilters)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ClearFiltersAsync">ล้างตัวกรอง</MudButton>
                }
            </MudPaper>
        }
        else
        {
            <MudPaper Outlined="true" Class="request-table-panel">
                <MudTable Items="_result.Items"
                          Hover="true"
                          Dense="true"
                          Breakpoint="Breakpoint.Sm"
                          Elevation="0">
                    <HeaderContent>
                        <MudTh>เลขที่คำขอ</MudTh>
                        <MudTh>นักศึกษา</MudTh>
                        <MudTh>ประเภททุน</MudTh>
                        <MudTh>จำนวนเงิน</MudTh>
                        <MudTh>สถานะ</MudTh>
                        <MudTh>วันที่ยื่น</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="item">
                        <MudTd DataLabel="เลขที่คำขอ"><strong>@item.RequestNumber</strong></MudTd>
                        <MudTd DataLabel="นักศึกษา">
                            <span class="student-name">@item.StudentName</span>
                            <small>@item.StudentId</small>
                        </MudTd>
                        <MudTd DataLabel="ประเภททุน">@item.ScholarshipTypeName</MudTd>
                        <MudTd DataLabel="จำนวนเงิน">@FormatMoney(item.RequestedAmount)</MudTd>
                        <MudTd DataLabel="สถานะ">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="@StatusClass(item.Status)">
                                @StatusLabel(item.Status)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="วันที่ยื่น">@FormatDate(item.SubmittedAt)</MudTd>
                        <MudTd>
                            <MudIconButton Href="@DetailUrl(item.Id)"
                                           Icon="@Icons.Material.Filled.ChevronRight"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           aria-label="@($"ดูรายละเอียดคำขอ {item.RequestNumber}")" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            <MudStack AlignItems="AlignItems.Center" Class="pagination">
                <MudPagination Count="@Math.Max(_result.TotalPages, 1)"
                               Selected="_result.Page"
                               SelectedChanged="GoToPageAsync"
                               Disabled="_loading"
                               Color="Color.Primary"
                               ShowFirstButton="true"
                               ShowLastButton="true" />
            </MudStack>
        }
    }
</section>
