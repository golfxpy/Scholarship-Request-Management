@page "/admin/requests/{Id:guid}"
@layout AdminLayout
@attribute [Authorize(Policy = AuthenticationConstants.StaffPolicy)]
@implements IAsyncDisposable

<PageTitle>รายละเอียดคำขอทุน</PageTitle>

<section class="detail-page" aria-labelledby="detail-title" aria-busy="@_loading">
    <MudButton Href="@BackUrl" Variant="Variant.Text" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack" Class="back-link">กลับรายการคำขอ</MudButton>

    @if (_loading)
    {
        <MudPaper Outlined="true" Class="state-card" role="status">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>กำลังโหลดรายละเอียดคำขอ...</MudText>
        </MudPaper>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="state-card">
            <MudText Typo="Typo.h5" id="detail-title">@(_error.StatusCode == 404 ? "ไม่พบคำขอทุน" : _error.Title)</MudText>
            <MudText>@(_error.Detail ?? "กรุณาลองอีกครั้ง")</MudText>
            @if (_error.StatusCode != 404)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="LoadAsync"
                           StartIcon="@Icons.Material.Filled.Refresh">ลองอีกครั้ง</MudButton>
            }
        </MudAlert>
    }
    else if (_detail is not null)
    {
        <header class="detail-header">
            <div>
                <MudText Typo="Typo.overline" Color="Color.Primary">REQUEST DETAIL</MudText>
                <MudText Typo="Typo.h3" id="detail-title">@_detail.RequestNumber</MudText>
                <MudText Typo="Typo.body2" Class="muted-text">ยื่นเมื่อ @FormatDate(_detail.SubmittedAt)</MudText>
            </div>
            <MudChip T="string" Variant="Variant.Outlined" Class="@StatusClass(_detail.Status)">@StatusLabel(_detail.Status)</MudChip>
        </header>

        @if (!_detail.CanEdit)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                <strong>คำขอนี้สิ้นสุดการพิจารณาแล้ว</strong><br />
                สถานะ Approved/Rejected เป็นข้อมูลอ่านอย่างเดียวและไม่สามารถเปิดกลับได้
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                <strong>คำขอนี้รอพิจารณา</strong><br />
                สามารถแก้ไข ลบ อนุมัติ หรือปฏิเสธได้ในขั้นตอนจัดการคำขอ
            </MudAlert>

            <section class="request-actions" aria-labelledby="request-actions-title">
                <div>
                    <h2 id="request-actions-title">จัดการคำขอ</h2>
                    <p>ตรวจสอบข้อมูลให้ครบก่อนอนุมัติหรือปฏิเสธ</p>
                </div>
                <div class="action-buttons">
                    <MudButton Href="@EditUrl" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">แก้ไข</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick='() => OpenAction("Approved")'>อนุมัติ</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick='() => OpenAction("Rejected")'>ปฏิเสธ</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick='() => OpenAction("Delete")'>ลบคำขอ</MudButton>
                </div>
            </section>

            @if (_activeAction is not null)
            {
                <MudPaper Outlined="true" Class="action-panel" role="dialog" aria-modal="true" aria-labelledby="action-panel-title">
                    <h2 id="action-panel-title">@ActionTitle</h2>
                    <p>@ActionDescription</p>
                    @if (_activeAction is "Approved" or "Rejected")
                    {
                        <MudTextField T="string" Label="@(_activeAction == "Rejected" ? "หมายเหตุ (จำเป็น)" : "หมายเหตุ")"
                                      Lines="4" MaxLength="2000" Immediate="true" Variant="Variant.Outlined"
                                      @bind-Value="_decisionNote" />
                    }
                    @if (!string.IsNullOrWhiteSpace(_actionError))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Text">@_actionError</MudAlert>
                    }
                    <div class="panel-actions">
                        <MudButton Variant="Variant.Text" Disabled="_actionSubmitting" OnClick="CloseAction">ยกเลิก</MudButton>
                        <MudButton Variant="Variant.Filled" Color="@(_activeAction == "Approved" ? Color.Success : Color.Error)"
                                Disabled="_actionSubmitting" OnClick="SubmitActionAsync">
                            @(_actionSubmitting ? "กำลังดำเนินการ..." : ConfirmActionLabel)
                        </MudButton>
                    </div>
                </MudPaper>
            }
        }

        <div class="detail-grid">
            <MudPaper Outlined="true" Class="detail-card" aria-labelledby="student-section-title">
                <h2 id="student-section-title">ข้อมูลนักศึกษา</h2>
                <dl>
                    <div><dt>รหัสนักศึกษา</dt><dd>@_detail.StudentId</dd></div>
                    <div><dt>ชื่อ-นามสกุล</dt><dd>@_detail.StudentName</dd></div>
                    <div><dt>คณะ/หน่วยการเรียน</dt><dd>@_detail.FacultyName</dd></div>
                    <div><dt>หลักสูตร/สาขาวิชา</dt><dd>@DisplayValue(_detail.Major)</dd></div>
                    <div><dt>ชั้นปี</dt><dd>@YearLabel(_detail)</dd></div>
                    <div><dt>GPAX</dt><dd>@_detail.Gpax.ToString("0.00")</dd></div>
                    <div><dt>อีเมล</dt><dd class="break-value">@_detail.Email</dd></div>
                </dl>
            </MudPaper>

            <MudPaper Outlined="true" Class="detail-card" aria-labelledby="funding-section-title">
                <h2 id="funding-section-title">ข้อมูลทุนและการเงิน</h2>
                <dl>
                    <div><dt>ประเภททุน</dt><dd>@_detail.ScholarshipTypeName</dd></div>
                    <div><dt>จำนวนเงินที่ขอ</dt><dd>@FormatMoney(_detail.RequestedAmount)</dd></div>
                    <div><dt>เลขบัญชี</dt><dd>@_detail.MaskedBankAccountNumber</dd></div>
                </dl>
                <h3>เหตุผลในการขอทุน</h3>
                <p class="long-text">@_detail.Reason</p>
            </MudPaper>

            <MudPaper Outlined="true" Class="detail-card" aria-labelledby="consent-section-title">
                <h2 id="consent-section-title">การรับทราบและความยินยอม</h2>
                <dl>
                    <div><dt>แหล่งคำขอ</dt><dd>@SourceLabel(_detail.SubmissionSource)</dd></div>
                    <div><dt>วิธีรับ consent</dt><dd>@ConsentLabel(_detail.ConsentMethod)</dd></div>
                    <div><dt>ประกาศ PDPA</dt><dd>เวอร์ชัน @_detail.PdpaNoticeVersion</dd></div>
                    <div><dt>วันที่รับ consent</dt><dd>@FormatDate(_detail.ConsentObtainedAt)</dd></div>
                    @if (!string.IsNullOrWhiteSpace(_detail.CreatedByName))
                    {
                        <div><dt>เจ้าหน้าที่ผู้บันทึก</dt><dd>@_detail.CreatedByName</dd></div>
                    }
                </dl>
                @if (!string.IsNullOrWhiteSpace(_detail.ConsentEvidenceNote))
                {
                    <h3>หลักฐาน/บันทึกประกอบ consent</h3>
                    <p class="long-text">@_detail.ConsentEvidenceNote</p>
                }
            </MudPaper>

            <MudPaper Outlined="true" Class="detail-card" aria-labelledby="decision-section-title">
                <h2 id="decision-section-title">ผลการพิจารณา</h2>
                @if (_detail.Status == "Pending")
                {
                    <p class="muted-text">ยังไม่มีผลการพิจารณา</p>
                }
                else
                {
                    <dl>
                        <div><dt>ผลการพิจารณา</dt><dd>@StatusLabel(_detail.Status)</dd></div>
                        <div><dt>ผู้พิจารณา</dt><dd>@DisplayValue(_detail.DecidedByName)</dd></div>
                        <div><dt>วันที่พิจารณา</dt><dd>@FormatOptionalDate(_detail.DecidedAt)</dd></div>
                    </dl>
                    <h3>หมายเหตุ</h3>
                    <p class="long-text">@DisplayValue(_detail.DecisionNote)</p>
                }
            </MudPaper>
        </div>

        <p class="updated-at">ปรับปรุงข้อมูลล่าสุด @FormatDate(_detail.UpdatedAt)</p>
    }
</section>
