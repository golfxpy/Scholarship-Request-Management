@page "/login"
@page "/admin/login"
@layout MainLayout

<PageTitle>เข้าสู่ระบบเจ้าหน้าที่</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="login-page">
    <MudPaper Class="login-card" Outlined="true">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="login-heading">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">S</MudAvatar>
            <div>
                <MudText Typo="Typo.overline" Color="Color.Primary">STAFF PORTAL</MudText>
                <MudText Typo="Typo.h4" id="login-title">เข้าสู่ระบบเจ้าหน้าที่</MudText>
                <MudText Typo="Typo.body2" Class="muted-text">จัดการและพิจารณาคำขอทุนการศึกษา</MudText>
            </div>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div tabindex="-1" @ref="_errorSummary">
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="login-error">
                    <MudText Typo="Typo.subtitle2">เข้าสู่ระบบไม่สำเร็จ</MudText>
                    <MudText Typo="Typo.body2">@_errorMessage</MudText>
                </MudAlert>
            </div>
        }

        <EditForm Model="_model"
                  OnValidSubmit="LoginAsync"
                  OnInvalidSubmit="HandleInvalidSubmit"
                  FormName="staff-login"
                  aria-busy="@_submitting.ToString().ToLowerInvariant()">
            <DataAnnotationsValidator />
            <div class="validation-summary-wrapper"
                 role="alert"
                 aria-live="polite"
                 tabindex="-1"
                 @ref="_validationSummary">
                <ValidationSummary class="validation-summary" />
            </div>

            <MudTextField T="string"
                          Label="ชื่อผู้ใช้"
                          @bind-Value="_model.UserName"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Normal"
                          autocomplete="username"
                          MaxLength="100"
                          Disabled="_submitting"
                          Required="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person" />
            <ValidationMessage For="@(() => _model.UserName)" />

            <MudTextField T="string"
                          Label="รหัสผ่าน"
                          @bind-Value="_model.Password"
                          Immediate="true"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Normal"
                          autocomplete="current-password"
                          MaxLength="200"
                          Disabled="_submitting"
                          Required="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="TogglePassword"
                          AdornmentAriaLabel="@(_showPassword ? "ซ่อนรหัสผ่าน" : "แสดงรหัสผ่าน")" />
            <ValidationMessage For="@(() => _model.Password)" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       Disabled="_submitting"
                       StartIcon="@(_submitting ? null : Icons.Material.Filled.Login)"
                       Class="login-button">
                @if (_submitting)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
                    <span>กำลังตรวจสอบ...</span>
                }
                else
                {
                    <span>เข้าสู่ระบบ</span>
                }
            </MudButton>
        </EditForm>

        <MudDivider Class="my-5" />
        <MudStack Spacing="1" Class="login-help">
            <MudLink Href="/" Underline="Underline.Hover">กลับไปหน้าสำหรับนักศึกษา</MudLink>
            <MudText Typo="Typo.caption" Class="muted-text">หากลืมรหัสผ่าน กรุณาติดต่อผู้ดูแลระบบ</MudText>
        </MudStack>
    </MudPaper>
</MudContainer>
