@page "/"

<PageTitle>ระบบจัดการคำขอทุนการศึกษา</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="home-page">
    <section class="hero" aria-labelledby="home-title">
        <MudGrid Spacing="6">
            <MudItem xs="12" md="7">
                <MudText Typo="Typo.overline" Color="Color.Primary">SCHOLARSHIP REQUEST MANAGEMENT</MudText>
                <MudText Typo="Typo.h1" id="home-title" Class="hero-title">
                    ส่งคำขอทุนได้ง่าย<br />และติดตามงานอย่างเป็นระบบ
                </MudText>
                <MudText Typo="Typo.body1" Class="hero-description muted-text">
                    แบบฟอร์มออนไลน์สำหรับนักศึกษาระดับปริญญาตรี วิทยาเขตหาดใหญ่
                    ข้อมูลจะถูกตรวจสอบก่อนส่งและออกเลขคำขอให้ทันทีเมื่อบันทึกสำเร็จ
                </MudText>
                <div class="hero-actions">
                    <MudButton Href="/apply"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.EditNote">
                        เริ่มยื่นคำขอทุน
                    </MudButton>
                    <MudButton Href="#how-it-works"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Large"
                               EndIcon="@Icons.Material.Filled.ArrowDownward">
                        ดูขั้นตอน
                    </MudButton>
                </div>
            </MudItem>

            <MudItem xs="12" md="5">
                <MudPaper Outlined="true" Class="preparation-panel">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary">เตรียมข้อมูลก่อนเริ่ม</MudText>
                    <MudList T="string" ReadOnly="true" Class="preparation-list">
                        <MudListItem Icon="@Icons.Material.Filled.School"
                                     IconColor="Color.Primary"
                                     Text="ข้อมูลการศึกษา"
                                     SecondaryText="รหัสนักศึกษา คณะ สาขา ชั้นปี และ GPAX" />
                        <MudListItem Icon="@Icons.Material.Filled.VolunteerActivism"
                                     IconColor="Color.Secondary"
                                     Text="ข้อมูลทุน"
                                     SecondaryText="ประเภททุน จำนวนเงิน และเหตุผลประกอบ" />
                        <MudListItem Icon="@Icons.Material.Filled.AccountBalance"
                                     IconColor="Color.Success"
                                     Text="ข้อมูลรับเงิน"
                                     SecondaryText="เลขบัญชีธนาคารที่ตรวจสอบความถูกต้องแล้ว" />
                    </MudList>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </section>

    <section id="how-it-works" class="how-section" aria-labelledby="how-title">
        <MudText Typo="Typo.overline" Color="Color.Primary">HOW IT WORKS</MudText>
        <MudText Typo="Typo.h3" id="how-title" Class="section-title">สามขั้นตอนในการส่งคำขอ</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudPaper Outlined="true" Class="step-panel">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">1</MudAvatar>
                    <MudText Typo="Typo.h6">กรอกแบบฟอร์ม</MudText>
                    <MudText Typo="Typo.body2" Class="muted-text">ระบุข้อมูลนักศึกษา การศึกษา ทุน และบัญชีธนาคารให้ครบถ้วน</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Outlined="true" Class="step-panel">
                    <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Medium">2</MudAvatar>
                    <MudText Typo="Typo.h6">ตรวจสอบและยอมรับ</MudText>
                    <MudText Typo="Typo.body2" Class="muted-text">อ่านประกาศความเป็นส่วนตัว ตรวจทานข้อมูล แล้วกดยืนยัน</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Outlined="true" Class="step-panel">
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Medium">3</MudAvatar>
                    <MudText Typo="Typo.h6">รับเลขคำขอ</MudText>
                    <MudText Typo="Typo.body2" Class="muted-text">ระบบบันทึกคำขอในสถานะรอพิจารณาและแสดงเลขอ้างอิง</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </section>

    <MudAlert Severity="Severity.Info"
              Variant="Variant.Outlined"
              Icon="@Icons.Material.Filled.PrivacyTip"
              Class="privacy-alert">
        <MudText Typo="Typo.subtitle1">ออกแบบโดยคำนึงถึงข้อมูลส่วนบุคคล</MudText>
        <MudText Typo="Typo.body2">เลขบัญชีถูกป้องกันก่อนจัดเก็บ และหน้าสำเร็จจะไม่แสดงข้อมูลบัญชีซ้ำ</MudText>
    </MudAlert>
</MudContainer>
